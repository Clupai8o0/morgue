# Copy to .env.local and fill in. Never commit .env.local.

# ─── Database ────────────────────────────────────────────────────────────────
# Neon → project → Connection string → "Pooled connection".
# Holds only the waitlist and CLI tokens; the vault itself is never in Postgres.
# Leave EMPTY until you have a real one. A placeholder value is worse than
# nothing: the app treats any non-empty string as "configured", then fails
# trying to reach a host that doesn't exist — so you get a 500 instead of the
# honest "not configured yet" message.
#   example: postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=""

# Salts the hashed IPs used for waitlist rate limiting. Any long random string.
# Without it the hashes are brute-forceable — IPv4 is only 4 billion guesses.
IP_HASH_SALT=""

# ─── Notifications ───────────────────────────────────────────────────────────
# Resend. Sending is skipped (not failed) when these are unset.
RESEND_API_KEY=""
NOTIFY_TO="clupaio4@gmail.com"
# Must be a verified domain in Resend; the default only sends to your own address.
NOTIFY_FROM="morgue <onboarding@resend.dev>"

# ─── Vault data source ───────────────────────────────────────────────────────
# "local" reads the sibling site/ directory — the fast local loop.
# "r2" reads the private bucket, which is what production does, because
# items/ is gitignored and Vercel never sees the collection.
MORGUE_DATA_SOURCE="local"
# MORGUE_SITE_DIR="/absolute/path/to/morgue/site"

# ─── Auth (GitHub OAuth) ─────────────────────────────────────────────────────
# GitHub → Settings → Developer settings → OAuth Apps → New.
#   Homepage:     https://morgue.clupai.com
#   Callback URL: https://morgue.clupai.com/api/auth/callback/github
#   (for local:   http://localhost:3210/api/auth/callback/github)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
# Signs the session JWT. Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Comma-separated GitHub logins allowed in. AN EMPTY VALUE DENIES EVERYONE,
# deliberately — a missing variable in production should lock the door.
AUTH_ALLOWED_LOGINS="Clupai8o0"

# ─── R2 storage ──────────────────────────────────────────────────────────────
# Cloudflare → R2 → Manage API tokens → Create (Object Read & Write).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# The private bucket must have NO public access. App auth is worthless if the
# mp4 behind it is fetchable by anyone holding a CDN link.
R2_BUCKET_PRIVATE="morgue-private"
R2_BUCKET_PUBLIC="morgue-public"
