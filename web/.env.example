# Copy to .env.local and fill in. Never commit .env.local.

# ─── Database ────────────────────────────────────────────────────────────────
# Neon → project → Connection string → "Pooled connection".
#   example: postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
#
# ANY Postgres works, not only Neon. src/db/index.ts picks its driver from the
# hostname: `*.neon.tech` gets the HTTP driver (no pool to exhaust from a
# serverless function), everything else gets node-postgres. So a local
# `postgres://postgres@127.0.0.1:5432/morgue` is a valid value for development,
# and `pnpm verify:auth` starts a throwaway cluster of its own.
#
# THIS IS NOW LOAD-BEARING FOR SIGN-IN. Accounts live in `users`; without a
# database there are no accounts and nobody can sign in. Email-and-password is
# unavailable entirely. Share links are the exception — they are signed, not
# stored, so they work with AUTH_SECRET alone.
#
# Leave EMPTY until you have a real one. A placeholder is worse than nothing:
# the app treats any non-empty string as "configured", then fails trying to
# reach a host that doesn't exist — a 500 instead of the honest "not configured
# yet" message.
DATABASE_URL=""

# Salts the hashed IPs used for waitlist rate limiting. Any long random string.
# Without it the hashes are brute-forceable — IPv4 is only 4 billion guesses.
IP_HASH_SALT=""

# ─── Notifications ───────────────────────────────────────────────────────────
# Resend. Sending is skipped (not failed) when these are unset.
RESEND_API_KEY=""
NOTIFY_TO="clupaio4@gmail.com"
# Must be a verified domain in Resend; the default only sends to your own address.
NOTIFY_FROM="morgue <onboarding@resend.dev>"

# ─── Vault data source ───────────────────────────────────────────────────────
# "local" reads the sibling site/ directory — the fast local loop.
# "r2" reads the private bucket, which is what production does, because
# items/ is gitignored and Vercel never sees the collection.
MORGUE_DATA_SOURCE="local"
# MORGUE_SITE_DIR="/absolute/path/to/morgue/site"

# ─── Auth ────────────────────────────────────────────────────────────────────
# Three ways in, and at least one must be configured or the front door is shut.
# In production an unconfigured deployment returns 503 rather than opening;
# in development it fails open so a fresh clone runs with no secrets at all.
#
# There is NO self-service sign-up. An account exists because someone ran
# `pnpm user add <email>`, and until the first one exists nobody can sign in —
# which is the old AUTH_ALLOWED_LOGINS rule (an empty value denies everyone)
# now expressed as a table rather than an env var. That variable is GONE; if
# you are reading it in an old .env.local, delete the line.

# Signs the session JWT AND read-only share links. Generate with:
#   openssl rand -base64 32
# Share links derive their own key from this through a labelled HMAC, so a
# share token and a session token are never interchangeable. Rotating it
# invalidates every outstanding share link at once — the break-glass switch.
AUTH_SECRET=""

# The public origin of this deployment. Used for the links in password-reset
# and verification emails, which must NOT be built from the request's Host
# header: that header is attacker-controlled, and a reset link pointed at
# somebody else's domain is how the token gets handed over. Required in
# production; in development it falls back to the request origin.
AUTH_URL="http://localhost:3210"

# GitHub → Settings → Developer settings → OAuth Apps → New.
#   Homepage:     https://morgue.clupai.com
#   Callback URL: https://morgue.clupai.com/api/auth/callback/github
#   (for local:   http://localhost:3210/api/auth/callback/github)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Google Cloud → APIs & Services → Credentials → OAuth client ID (Web).
#   Authorised redirect URI: https://morgue.clupai.com/api/auth/callback/google
#   (for local:              http://localhost:3210/api/auth/callback/google)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# How long a session JWT may go unchecked against the database, in seconds.
# This IS the revocation lag: suspending someone or bumping their
# sessionVersion takes effect within this window. 0 means a query on every
# authenticated request — instant revocation, at the cost the JWT strategy
# exists to avoid. Default 60.
# AUTH_SESSION_RECHECK_SECONDS="60"

# Needed only when self-hosting behind a proxy; Vercel implies it. Auth.js
# refuses a Host header it has not been told to trust.
# AUTH_TRUST_HOST="true"

# ─── R2 storage ──────────────────────────────────────────────────────────────
# Cloudflare → R2 → Manage API tokens → Create (Object Read & Write).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# The private bucket must have NO public access. App auth is worthless if the
# mp4 behind it is fetchable by anyone holding a CDN link.
R2_BUCKET_PRIVATE="morgue-private"
R2_BUCKET_PUBLIC="morgue-public"
